# Public URL used for canonical URLs, alternate language links, sitemap and robots.
NEXT_PUBLIC_SITE_URL=

# Resend is used only in production when every value below is configured.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=

# Optional: Turnstile is verified only when its server secret is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
